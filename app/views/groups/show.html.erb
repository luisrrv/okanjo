<% content_for :title, group_title(@group) %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @group %>

<%# Live refreshes morph this page; keep-edits stops them wiping a field mid-typing (ADR 0019). %>
<div data-controller="keep-edits"
     data-action="input->keep-edits#mark submit->keep-edits#unmark turbo:before-morph-element@document->keep-edits#keep">
  <div class="flex items-baseline justify-between gap-2">
    <h1 class="text-2xl font-bold"><%= group_title(@group) %></h1>
    <%= link_to t(".receipt_link"), group_receipt_path(@group), class: "shrink-0 text-sm text-stone-500 underline" %>
  </div>
  <p class="mt-1 text-sm text-stone-500">
    <%= t(".deletion_notice", date: l(@group.deletion_date, format: :long)) %>
  </p>

  <% if current_member %>
    <div class="mt-4 flex items-center gap-2 text-sm">
      <span><%= t(".you_are", name: current_member.name) %></span>
      <%= button_to t(".change_identity"), group_identity_path(@group), method: :delete,
            class: "text-stone-500 underline" %>
    </div>
  <% elsif @group.members.any? %>
    <%= render "identities/banner", group: @group %>
  <% end %>

  <%= render "settlements/settlement", group: @group %>

  <%= render "expenses/expenses", group: @group %>

  <%= render "members/members", group: @group, member: @member %>

  <section class="mt-6 rounded-lg bg-white p-4 shadow-sm">
    <%= label_tag :share_link, t(".share_link"), class: "block text-sm font-bold" %>
    <%= text_field_tag :share_link, group_url(@group), readonly: true,
          class: "mt-1 w-full rounded-md border border-stone-300 bg-stone-50 px-3 py-2 text-sm" %>
  </section>
</div>
