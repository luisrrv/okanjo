<section class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4">
  <h2 class="font-bold"><%= t(".title") %></h2>

  <div class="mt-3 flex flex-wrap gap-2">
    <% group.members.order(:id).each do |member| %>
      <%# Shown only when you have no member here, so a linked one is another account's (ADR 0022). %>
      <% if member.user_id? && authenticated? %>
        <span class="rounded-full border border-stone-200 bg-stone-100 px-4 py-1 text-stone-500">
          <%= member.name %> <span class="text-xs"><%= t(".claimed") %></span>
        </span>
      <% else %>
        <%= button_to group_identity_path(group), params: { member_id: member.id },
              class: "rounded-full border border-stone-300 bg-white px-4 py-1" do %>
          <%= member.name %>
          <% if member.user_id? %><span class="text-xs text-stone-500"><%= t(".claimed") %></span><% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= form_with model: [ group, Member.new ], class: "mt-4" do |form| %>
    <%= hidden_field_tag :me, 1 %>
    <%= form.label :name, t(".not_listed"), class: "block text-sm" %>
    <div class="mt-1 flex gap-2">
      <%= form.text_field :name, required: true, maxlength: 50,
            class: "w-full rounded-md border border-stone-300 bg-white px-3 py-2" %>
      <%= form.submit t(".add_me"), class: "rounded-md bg-stone-900 px-4 py-2 font-bold text-white" %>
    </div>
  <% end %>
</section>
