<% content_for :title, t(".title") %>

<h1 class="mb-6 text-2xl font-bold"><%= t(".title") %></h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4 rounded-lg bg-white p-4 shadow-sm" do |form| %>
  <div>
    <%= form.label :password, t(".password"), class: "block text-sm font-bold" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
          class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :password_confirmation, t(".password_confirmation"), class: "block text-sm font-bold" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
          class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <%= form.submit t(".submit"), class: "w-full rounded-md bg-stone-900 px-4 py-3 font-bold text-white" %>
<% end %>
