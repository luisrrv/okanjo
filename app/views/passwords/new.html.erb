<% content_for :title, t(".title") %>

<h1 class="mb-2 text-2xl font-bold"><%= t(".title") %></h1>
<p class="mb-6 text-sm text-stone-500"><%= t(".note") %></p>

<%= form_with url: passwords_path, class: "space-y-4 rounded-lg bg-white p-4 shadow-sm" do |form| %>
  <div>
    <%= form.label :email_address, t(".email"), class: "block text-sm font-bold" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <%= form.submit t(".submit"), class: "w-full rounded-md bg-stone-900 px-4 py-3 font-bold text-white" %>
<% end %>
