<% content_for :title, t(".title") %>

<h1 class="mb-2 text-2xl font-bold"><%= t(".title") %></h1>
<p class="mb-6 text-sm text-stone-500"><%= t(".note") %></p>

<%= form_with model: @user, url: registration_path, class: "space-y-4 rounded-lg bg-white p-4 shadow-sm" do |form| %>
  <%= render "shared/errors", model: @user %>

  <div>
    <%= form.label :email_address, class: "block text-sm font-bold" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :password, class: "block text-sm font-bold" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
          class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :password_confirmation, class: "block text-sm font-bold" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
          class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <%= form.submit t(".submit"), class: "w-full rounded-md bg-stone-900 px-4 py-3 font-bold text-white" %>
<% end %>

<p class="mt-4 text-sm">
  <%= link_to t(".sign_in"), new_session_path, class: "text-stone-500 underline" %>
</p>
