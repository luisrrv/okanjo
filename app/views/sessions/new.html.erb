<% content_for :title, t(".title") %>

<h1 class="mb-6 text-2xl font-bold"><%= t(".title") %></h1>

<%= form_with url: session_path, class: "space-y-4 rounded-lg bg-white p-4 shadow-sm" do |form| %>
  <div>
    <%= form.label :email_address, t(".email"), class: "block text-sm font-bold" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :password, t(".password"), class: "block text-sm font-bold" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <%= form.submit t(".submit"), class: "w-full rounded-md bg-stone-900 px-4 py-3 font-bold text-white" %>
<% end %>

<div class="mt-4 flex justify-between text-sm">
  <%= link_to t(".forgot"), new_password_path, class: "text-stone-500 underline" %>
  <%= link_to t(".sign_up"), new_registration_path, class: "text-stone-500 underline" %>
</div>
