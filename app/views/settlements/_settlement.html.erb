<% sheet = BalanceSheet.new(group) %>
<% settlement = Settlement.new(sheet.balances) %>

<section id="settlement" class="mt-6 rounded-lg bg-white p-4 shadow-sm">
  <h2 class="text-sm font-bold"><%= t(".heading") %></h2>

  <ul class="mt-2 divide-y divide-stone-200">
    <% sheet.rows.each do |row| %>
      <li class="flex items-baseline justify-between gap-2 py-2">
        <div>
          <p><%= row.member.name %></p>
          <p class="text-xs text-stone-500">
            <%= t(".row", credited: number_to_currency(row.credited), owed: number_to_currency(row.owed)) %>
          </p>
        </div>
        <% if row.balance.positive? %>
          <span class="font-bold text-emerald-700"><%= t(".receives", amount: number_to_currency(row.balance)) %></span>
        <% elsif row.balance.negative? %>
          <span class="font-bold text-red-700"><%= t(".pays", amount: number_to_currency(-row.balance)) %></span>
        <% else %>
          <span class="text-stone-500"><%= number_to_currency(0) %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="mt-3 rounded-md bg-stone-50 p-3">
    <% if settlement.transfers.any? %>
      <p class="text-sm font-bold"><%= t(".collector", name: settlement.collector.name) %></p>
      <ul class="mt-2 space-y-1">
        <% settlement.transfers.each do |transfer| %>
          <li class="flex justify-between text-sm">
            <span><%= t(".transfer", from: transfer.from.name, to: transfer.to.name) %></span>
            <span class="font-bold"><%= number_to_currency(transfer.amount) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-stone-500"><%= t(".nothing") %></p>
    <% end %>
  </div>
</section>
