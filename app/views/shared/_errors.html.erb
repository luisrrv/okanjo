<% if model.errors.any? %>
  <div class="mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
    <p class="font-bold"><%= t(".heading") %></p>
    <ul class="mt-1 list-disc pl-5">
      <% model.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
